# Copy to backend/.env for local development. Never commit the real .env.
DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# TomTom developer key (free, no credit card): https://developer.tomtom.com
TOMTOM_API_KEY=

# Weather providers, tried in order. Each later provider fills only the cells, or the missing
# values, the earlier ones couldn't supply. See docs/WEATHER_PROVIDERS.md.
WEATHER_PROVIDERS=weatherapi,nws
# WeatherAPI.com key (primary; free plan: 100K calls/month, 3 forecast days). Without it the
# chain is NWS only. Get one at https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=
# Forecast days your WeatherAPI plan allows: Free 3, Starter 7.
WEATHERAPI_DAYS=3
# NWS (api.weather.gov) needs no key, only a User-Agent naming the app and a contact.
# Leave empty for the default "truck-weather-routing/1.0 (+<repo URL>)".
NWS_USER_AGENT=
# Optional: add open-meteo to WEATHER_PROVIDERS (free endpoint, or the commercial one with a key).
OPEN_METEO_API_KEY=

# Optional overrides
API_THROTTLE_RATE=60/min
HTTP_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
